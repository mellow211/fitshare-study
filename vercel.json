{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{measure_dataset,실측배경,docs,assets,css,js,modules,measure,results,Handspff,규칙,experiments/garment_ai/hrnet,server-data}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
